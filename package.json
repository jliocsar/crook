{
  "$schema": "http://json.schemastore.org/package",
  "name": "crook",
  "version": "0.0.13",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@effect/atom-react": "4.1.2",
      "@effect/platform-bun": "4.1.2",
      "@effect/sql-sqlite-bun": "4.1.2",
      "@effect/vitest": "4.1.2",
      "effect": "4.1.2"
    }
  },
  "scripts": {
    "test": "bun run --filter '*' --if-present test",
    "typecheck": "bun run --filter '*' --if-present typecheck",
    "build": "bun run --filter '*' --if-present build",
    "stories": "bun run --cwd packages/web stories",
    "stories:list": "bun run --cwd packages/web stories:list",
    "release:build": "bun packages/release/src/main.ts build",
    "release:build:host": "bun packages/release/src/main.ts build --host",
    "lint": "oxlint --deny-warnings --no-error-on-unmatched-pattern --disable-nested-config",
    "lint:fix": "oxlint --fix --deny-warnings --no-error-on-unmatched-pattern --disable-nested-config",
    "fmt": "oxfmt --disable-nested-config",
    "fmt:check": "oxfmt --check --disable-nested-config",
    "frames": "bun packages/frames/src/main.ts",
    "verify:transcript-pipe": "bun .claude/skills/verify-transcript-pipe/verify.ts",
    "prepare": "git config core.hooksPath .githooks && effect-tsgo patch --oxlint"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.4",
    "@effect/vitest": "catalog:",
    "@jliocsar/begone-slop": "^0.2.12",
    "@types/bun": "^1.3.14",
    "effect": "catalog:",
    "oxfmt": "^0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  }
}
