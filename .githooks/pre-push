#!/usr/bin/env sh
# Whole-repo lint and format check, then only the tests the pushed commits can
# affect: vitest --changed walks each member's module graph, other members'
# sources included, and reruns everything when a package.json or config moved.
# Each ref is peeled to its commit, and a commit the remote already holds tests
# nothing, so a release tag pushed after its branch runs no tests.

node_modules/.bin/oxlint --deny-warnings --no-error-on-unmatched-pattern --disable-nested-config || exit 1
bunx oxfmt --check --disable-nested-config || exit 1

remote=$1
zero=0000000000000000000000000000000000000000
head=$(git rev-parse HEAD)
base=""
whole=""

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  commit=$(git rev-parse --verify --quiet "$local_sha^{commit}") || continue
  [ -n "$(git for-each-ref --count=1 --contains "$commit" "refs/remotes/$remote/")" ] && continue
  if [ "$commit" != "$head" ]; then whole=1; continue; fi
  if [ "$remote_sha" = "$zero" ]; then
    candidate=$(git merge-base "$commit" origin/main 2>/dev/null) || { whole=1; continue; }
  elif git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    candidate=$remote_sha
  else
    whole=1
    continue
  fi
  [ -n "$base" ] && [ "$base" != "$candidate" ] && whole=1
  base=$candidate
done

if [ -z "$whole" ] && [ -z "$base" ]; then
  exit 0
elif [ -n "$whole" ]; then
  bun run test || exit 1
else
  bun run test --changed "$base" || exit 1
fi
