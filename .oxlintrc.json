{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",

  // The Effect rules. The preset also sets `options.typeAware`, which they all
  // require. Extends are applied in order and rules below take precedence.
  "extends": [
    "./node_modules/@effect/tsgo/oxlint-presets/recommended.json",
    "./node_modules/@effect/tsgo/oxlint-presets/effect-native.json",
    "./node_modules/@jliocsar/begone-slop/preset.json"
  ],

  // Listing plugins explicitly is what turns off oxlint's unicorn/oxc defaults.
  "plugins": ["typescript", "promise", "effecttsgo"],

  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error"
  },

  "ignorePatterns": [
    "**/dist/**",
    "**/*.d.ts",
    "**/routeTree.gen.ts",
    ".claude/**",
    ".agents/**",
    ".husky/**"
  ],

  // `jsPlugins` resolves a package specifier; `extends` above does not, hence
  // the path. The severities live in the package's own `preset.json`.
  "jsPlugins": ["@jliocsar/begone-slop"],

  "rules": {
    // Their quickfixes write `Effect.asVoid` and a log-less `Effect.ignore`, which begone-slop rejects.
    "effecttsgo/effect-map-void": "off",
    "effecttsgo/catch-to-ignore": "off",
    // Native string, array and record methods read fine; `effect/String`, `effect/Array` and
    // `effect/Record` are for what native lacks, not a rewrite of what it has.
    "effecttsgo/prefer-effect-string": "off",
    "effecttsgo/prefer-effect-array": "off",
    "effecttsgo/prefer-effect-record": "off",
    // `JSON.stringify` on plain data outside an Effect can't fail; inside one, `global-json-in-effect`
    // still asks for a Schema codec.
    "effecttsgo/global-json": "off",
    // crook is built on the modules Effect tags unstable: the platform services, SQL, RPC, atoms and
    // `@effect/vitest`. A rule that flags every use of them can't single out a risky one.
    "effecttsgo/unstable-api-usage": "off",
    // A sync encode of a value its type already checked can't fail on shape, and a sync decode that
    // throws in a test fails the test, which is what a test wants.
    "effecttsgo/schema-sync": "off",
    // A schema's derived type shares the schema's name, which this rule reads as a redeclaration.
    // The compiler still rejects a real one.
    "no-redeclare": "off",
    // `Data.TaggedEnum` spells a variant with no fields as `Record<never, never>`, which is `{}`.
    "typescript/no-generated-empty-object-type": "off",

    // Leaf imports only. A barrel is the bare root, `effect/testing`, or a single
    // lowercase segment under `effect/` — every leaf module is PascalCase.
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "regex": "^effect$|^effect/[a-z0-9-]+$",
            "allowTypeImports": true,
            "message": "Import the leaf module, not the barrel: `effect/Effect`, `effect/rpc/Rpc`."
          }
        ]
      }
    ],

    // Off until oxc stops treating a namespace import as a possible Promise: it reports every
    // `Effect.catch` and `Stream.catch` that isn't under a `yield` or `await`. `effect-native`
    // keeps Promises out of Effect code, so there's no real chain for it to catch.
    "promise/prefer-await-to-then": "off",

    "id-length": ["error", { "min": 2, "exceptions": ["i", "j"], "properties": "never" }],

    "no-else-return": ["error", { "allowElseIf": false }],
    "no-nested-ternary": "error",
    "prefer-template": "error",
    "complexity": ["error", 15],
    // Off, not tuned. One `Schema.TaggedErrorClass` per failure reason is this
    // codebase's error doctrine, so a module that can fail two ways already
    // declares two classes and a service tag makes a third. A cap of one does not
    // shrink a module, it scatters one concern across several files.
    "max-classes-per-file": "off",
    // 1000, not the default 300. Same reasoning: a line cap does not shrink code,
    // it relocates it into a module that exists only to sit under the cap. High
    // enough to catch a genuinely sprawling file, not a coherent one.
    "max-lines": ["error", 1000],
    // 200 because Effect.fn bodies are a linear chain of `yield*` steps; each step
    // is already its own composable Effect, so "extract a helper" doesn't apply.
    "max-lines-per-function": [
      "error",
      { "max": 200, "skipBlankLines": true, "skipComments": true, "IIFEs": true }
    ],
    // Effect.fn wraps a generator that may have zero `yield*`.
    "require-yield": "off",
    "no-empty": ["error", { "allowEmptyCatch": true }],

    // Demands `readonly` on every object parameter; never in strictTypeChecked.
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/array-type": ["error", { "default": "array", "readonly": "array" }],
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "typescript/consistent-type-imports": [
      "error",
      { "prefer": "type-imports", "fixStyle": "separate-type-imports" }
    ],
    "typescript/restrict-template-expressions": [
      "error",
      { "allowNumber": true, "allowBoolean": true }
    ]
  },

  "overrides": [
    {
      "files": ["packages/*/*.config.ts"],
      "rules": {
        "effecttsgo/async-function": "off",
        "effecttsgo/node-builtin-import": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/test/**/*.ts", "**/test/**/*.tsx"],
      "rules": {
        "begone-slop/expect-padding": "error",
        "max-lines-per-function": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/no-confusing-void-expression": "off",
        "typescript/no-unnecessary-type-conversion": "off"
      }
    }
  ]
}
