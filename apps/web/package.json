{
  "name": "@crook/web",
  "version": "0.0.13",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "vite --port 5190 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 5191 --strictPort",
    "typecheck": "tsr generate && tsc && tsc -p src/sw",
    "test": "tsr generate && vitest run --fsModuleCachePath node_modules/.vitest-cache",
    "brand": "bun brand/Generate.ts",
    "charts": "bun charts/Generate.ts",
    "stories": "tsr generate && vite --config vite.stories.config.ts --port 5192 --strictPort",
    "stories:list": "tsr generate && bun stories/List.ts",
    "typecheck:kitchen": "tsc -p tsconfig.kitchen.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
