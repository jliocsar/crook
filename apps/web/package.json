    "@tanstack/react-virtual": "^3.14.21",
    "cn": "^0.5.0",
    "effect": "catalog:",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.60.0",
    "motion": "^14.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
