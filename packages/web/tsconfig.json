{
  "extends": "@crook/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@crook/web/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "stories/**/*.ts",
    "stories/**/*.tsx",
    "brand/**/*.ts",
    "charts/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "vite.stories.config.ts",
    "pwa-assets.config.ts"
  ],
  "exclude": ["src/sw/**", "stories/kitchen/**"]
}
