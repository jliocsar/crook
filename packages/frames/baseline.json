{
  "actions/toast-after-chat-close": {
    "always": ["blank"]
  },
  "ask/next-ask": {
    "always": ["shift:div[chat-dock]"]
  },
  "machine/forgotten-while-open": {
    "always": ["shift:div[swipe-card]"]
  },
  "new-agent/start-to-chat": {
    "always": ["shift:div[new-agent-dock]"]
  },
  "transition/clear": {
    "always": ["shift:div[chat-dock]"]
  },
  "transition/foreground-return": {
    "always": [
      "flash:thread-skeleton",
      "shift:div[conversation-viewport]",
      "flash:catching-up",
      "flash:spinner"
    ]
  },
  "transition/herd-first-load-empty": {
    "always": [],
    "sometimes": ["flash:banner", "flash:spinner"]
  },
  "transition/herd-first-load-from-cache": {
    "always": [],
    "sometimes": ["flash:banner", "flash:spinner"]
  },
  "transition/machine-redial": {
    "always": [
      "order:dock:composer>edge-card",
      "shift:div[chat-dock]",
      "order:dock:edge-card>composer"
    ]
  },
  "transition/reconnect-chat-open": {
    "always": ["flash:thread-skeleton", "flash:catching-up", "flash:spinner"]
  }
}
